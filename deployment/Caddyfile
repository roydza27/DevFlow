http://devflow.localhost {
    # ── 1. Static Web Server ──────────────────────────────────────────────────
    root * /home/cy3pher/Documents/WorkSpace-Tools/DevFlow/frontend/dist

    # ── 2. Automatic Compression ──────────────────────────────────────────────
    encode gzip zstd

    # ── 3. Reverse Proxy API Handler ─────────────────────────────────────────
    # Forward all /api/* requests directly to Express backend on port 3001
    handle /api/* {
        reverse_proxy localhost:3001
    }

    # ── 4. Static File Server & SPA Client Routing Fallback ───────────────────
    handle {
        try_files {path} /index.html
        file_server
    }
}
